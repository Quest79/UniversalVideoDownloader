{
  "manifest_version": 2,
  "name": "Universal Video Downloader",
  "version": "4.4.0",
  "description": "Right-click video downloader using yt-dlp + FFmpeg with selectable quality and audio merging.",
  "homepage_url": "https://github.com/Quest79/UniversalVideoDownloader/releases/latest",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "universal-video-downloader@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent",
          "websiteActivity"
        ]
      }
    }
  }
}
